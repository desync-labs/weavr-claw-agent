    {
      "name": "initialize",
      "docs": [
        "Creates `AdapterConfig`, once (plain init). Only nav's on-chain",
        "governance may sign — the same identity that later runs",
        "`set_price_source` — so a front-runner at the pinned program id gains",
        "nothing. Governance is read from nav's `NavConfig` at a fixed offset",
        "(layout documented at `NAV_CONFIG_GOVERNANCE_OFFSET`) rather than",
        "through the nav crate, which would be a dependency cycle."
      ],
      "discriminator": [
        175,
        175,
        109,
        31,
        13,
        152,
        155,
        237
      ],
      "accounts": [
        {
          "name": "governance",
          "docs": [
            "Must be nav's on-chain governance; becomes `config.governance`."
          ],
          "writable": true,
          "signer": true
        },
        {
          "name": "config",
          "writable": true
        },
        {
          "name": "nav_config",
          "docs": [
