# Claw Agent (Hermes) + weavr: environment names only. Real values go in
# $HERMES_HOME/.env (0600) or the container's env file; never in git.

# Model
ANTHROPIC_API_KEY=

# Which wallet signs. Unset: local when SIGN_LOCAL_KEYPAIR_FILE is set, else
# paybox when any PAYBOX_* variable is set (a missing one is then CONFIG, named),
# else link when nothing is configured. `--wallet <x>` on the tool's command
# line beats this variable.
#   paybox  the PayBox CLI signs: the key is off the box and a human approves each signature (the default for a real wallet)
#   local   a dedicated keypair file that lives on this box signs (an autonomous curator, or a small creator wallet)
#   link    this host has no signer: the owner signs the create in a browser from the sign link; deposits are made on the portfolio's page
WEAVR_WALLET=

# PayBox CLI (@paybox-sh/sdk), the default for a real wallet. The signing key
# stays in a file under PAYBOX_CONFIG_DIR; the tool exports it to the CLI per run.
PAYBOX_CONFIG_DIR=            # e.g. $COMPOSABLE_PORTFOLIOS_KEY_DIR/paybox-cli (0700)
PAYBOX_CREDENTIAL_ID=         # wallet credential id from `paybox credentials`
PAYBOX_SIGNING_KEY_FILE=      # default $PAYBOX_CONFIG_DIR/signing-key.txt (0600, one line, pbxk1.…)
PAYBOX_CLI=                   # path to node_modules/@paybox-sh/sdk/dist/cli.js

# Local key: a dedicated keypair file that lives on the box (a 64-byte JSON
# array, 0600, under a directory outside the repo). The path, never the key, is
# in the environment. Keep on that wallet only what it needs. The tool refuses
# (CONFIG) a file readable by group or others, or one that is not a 64-byte JSON
# array (a base58 export is not accepted), without quoting the file.
SIGN_LOCAL_KEYPAIR_FILE=

# Wallet tool
WEAVR_SIGN_TOOL=              # path to tools/sign.mjs (sign-solana.mjs and sign-local.mjs are aliases that force one wallet); unset with WEAVR_WALLET=link
WEAVR_MANIFEST=               # optional: this repo's manifest.json is found automatically; or WEAVR_PROGRAM_IDS=a,b,c
WEAVR_MCP_URL=https://api.weavr.sh/mcp
WEAVR_API_URL=https://api.weavr.sh
# Phase 3 partner key (commented header in config.yaml)
# WEAVR_PARTNER_KEY=

# Telegram gateway
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=       # comma-separated numeric user ids
