# The curator signer's secrets. Copy to a 0600 file outside any git checkout
# and point CURATOR_SIGNER_ENV at it. Names only here; never a value in git.
# Tokens: 64 hex chars each (openssl rand -hex 32), the two different, no
# trailing whitespace. The signer refuses to boot otherwise.

# Bearer the agent uses; the same value goes into the agent's .env.
CURATOR_SIGNER_TOKEN=
# Bearer for resume, unlock, rotate-curator, set-delay, set-metadata and
# operator requests. Only your machine ever holds it; never the agent.
CURATOR_OPS_TOKEN=
# Solana RPC endpoint. Never logged, never journaled, never in an error.
SOLANA_RPC_URL=
