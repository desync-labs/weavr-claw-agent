# The agent's environment: $HERMES_HOME/.env (0600). weavr-curator init writes
# it; this file lists the names. Never a value in git.

# Model provider key: OPENAI_API_KEY for the template's openai-api provider,
# or the key your config.yaml provider reads (ANTHROPIC_API_KEY, OPENROUTER_API_KEY).
OPENAI_API_KEY=

# Telegram: the bot, the numeric ids allowed to talk to it (comma-separated;
# an empty list is fail-open, the doctor refuses it), the chat briefs land in.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_HOME_CHANNEL=

# The signer, as reached from inside the compose network (see curator.yml).
CURATOR_SIGNER_URL=http://signer:8091
# The same value as CURATOR_SIGNER_TOKEN in the signer's env file.
CURATOR_SIGNER_TOKEN=

# weavr's MCP server (the read tools) and, for the universe watch's fallback, the api.
WEAVR_MCP_URL=https://api.weavr.sh/mcp
WEAVR_API_URL=https://api.weavr.sh

# Only shape what the owner reads before approving a write in chat: the
# portfolio's ticker and its onchain notice in seconds. init copies both from
# chain; unset, the approval text names no book and announces no notice.
CURATOR_PORTFOLIO_SYMBOL=
CURATOR_REBALANCE_DELAY_SECS=
